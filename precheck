#!/bin/bash
# PreToolUse hook: tighten-only. Deny the agent's loosening attempts. Tier 1 deterrent.
set -eu
shopt -s extglob
self="$0"; while [ -L "$self" ]; do l="$(readlink "$self")"; case "$l" in /*) self="$l";; *) self="$(dirname "$self")/$l";; esac; done
SELF_DIR="$(cd "$(dirname "$self")" && pwd)"
GATE_HOOKS="$(cd "$SELF_DIR/hooks" && pwd)"

input="$(cat)"
tool="$(printf '%s' "$input" | jq -r '.tool_name // empty')"
deny() { jq -cn --arg r "$1" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}'; exit 0; }

case "$tool" in
  Bash)
    cmd="$(printf '%s' "$input" | jq -r '.tool_input.command // empty')"
    padded=" $cmd "   # boundary trick: pad so start/end-of-string count as "preceded/followed by a space"

    # Checks 1 & 4 need a bounded "gap that doesn't cross ; & |" — [^;&|]* in regex terms.
    # That negated-class repetition is expressible in extglob (+([!;&|])) but an escaped
    # extglob negated-repetition construct hit an unpredictable bash-3.2 parser failure in
    # testing (reproducible in some surrounding contexts, not others, cause not isolated) —
    # too fragile for a security file. Kept as native [[ =~ ]] (pattern in a single-quoted
    # variable, referenced unquoted — the safe idiom; inlining it directly caused a
    # different, confirmed parser break on the bare ';').
    p1='git[^;&|]*commit'
    p1b='[[:space:]](--no-verify|-n)[[:space:]]'
    if [[ "$cmd" =~ $p1 ]] && [[ "$padded" =~ $p1b ]]; then
      deny "commit-gate: --no-verify/-n is not allowed for the agent. Get approval, or the human can run '! git commit --no-verify'."
    fi

    case "$cmd" in
      *commit-gate.disabled*)
        deny "commit-gate: the agent may not opt a repo out (commit-gate.disabled is human-only)." ;;
    esac

    case "$cmd" in
      *core.hooksPath*)
        # Match on $padded (leading+trailing space) so the comparison requires a real
        # boundary right after $GATE_HOOKS — a bare trailing "*" would let a LONGER path
        # ("$GATE_HOOKS/sub") false-match as if it were the real gate path, since it
        # contains the real path as a literal prefix (a real bypass; see TODO.md).
        case "$padded" in
          *"core.hooksPath $GATE_HOOKS "*|*"core.hooksPath=$GATE_HOOKS "*)
            : ;;   # enable (point at the gate) is a tighten — allowed
          *)
            deny "commit-gate: the agent may only set core.hooksPath to the gate (enable); not elsewhere or --unset." ;;
        esac ;;
    esac

    p4='(>>?|rm |mv |cp |tee |truncate|sed -i)[^|;&]*(\.git/config|\.git/hooks|commit-gate)'
    if [[ "$cmd" =~ $p4 ]]; then
      deny "commit-gate: the agent may not modify gate state, native hooks, or .git/config."
    fi

    # Must anchor to a COMMAND position (start of string, or right after ; & |), not just
    # "the word appears anywhere bounded by spaces" — the earlier padding-based case version
    # of this check denied "git log --grep approve" (approve is an ARGUMENT there, not the
    # command being run). Genuinely positional, like checks 1 & 4 — kept as [[ =~ ]].
    # Trailing boundary accepts ; & | too (not just whitespace/end-of-string), symmetric
    # with the leading side — "approve;anything" is a real, standalone "approve" invocation
    # in bash regardless of what immediately follows, with no space required.
    p5='(^[[:space:]]*|[;&|][[:space:]]*)(approve|approve-push|gate-disable)([[:space:]]|[;&|]|$)'
    if [[ "$cmd" =~ $p5 ]]; then
      deny "commit-gate: the agent may not run approve/approve-push/gate-disable — these are human-only (run via ! or a terminal)."
    fi

    p6='git[[:space:]]+([^;&|]*[[:space:]])?(commit|push)[[:space:]]'
    if [[ "$padded" =~ $p6 ]]; then
      cwd="$(printf '%s' "$input" | jq -r '.cwd // empty')"
      ( [ -n "$cwd" ] && cd "$cwd" 2>/dev/null
        hp="$(git config --get core.hooksPath 2>/dev/null || true)"
        [ -n "$hp" ] && [ "$(cd "$hp" 2>/dev/null && pwd)" = "$GATE_HOOKS" ]
      ) && jq -cn '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"allow",additionalContext:"commit-gate is enabled in this repo. Protocol (~/.claude/knowledge/projects/commit-gate.md): do NOT pre-ask. Write the message to a short /tmp path (e.g. /tmp/cgmsg), run `git commit -F <path>` (or push); if rejected it stages cg-pending — THEN show the message in chat and ask the user to run the bare `approve` (or `approve-push`) command. Batch plans: one `approve -F <file>` up front, messages separated by @@COMMIT-GATE-SEP@@."}}'
    fi
    exit 0 ;;
  Write|Edit|MultiEdit|NotebookEdit)
    path="$(printf '%s' "$input" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty')"
    case "$path" in
      */commit-gate/*) deny "commit-gate: the agent may not edit gate state or scripts." ;;
      */.git/hooks/*)  deny "commit-gate: the agent may not edit native git hooks." ;;
      */.git/config)   deny "commit-gate: the agent may not edit .git/config." ;;
      */.claude/settings.json) deny "commit-gate: the agent may not edit settings.json." ;;
    esac
    exit 0 ;;
  *) exit 0 ;;
esac
