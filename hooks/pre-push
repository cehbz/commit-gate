#!/bin/bash
set -eu
self="$0"; while [ -L "$self" ]; do l="$(readlink "$self")"; case "$l" in /*) self="$l";; *) self="$(dirname "$self")/$l";; esac; done
SELF_DIR="$(cd "$(dirname "$self")" && pwd)"; . "$SELF_DIR/../lib/common"
gate_dir >/dev/null 2>&1 || exit 0
chain_local pre-push "$@"        # native pre-push first (gets args + stdin ref list)
is_disabled && exit 0
g="$(gate_dir)"
if [ -e "$g/push-token" ]; then rm -f "$g/push-token"; exit 0; fi
{
  echo "commit-gate: push not approved."
  echo "Have the user run:  approve-push"
  echo "Human override:     git push --no-verify"
} >&2
exit 1
