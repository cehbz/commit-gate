#!/bin/bash
set -eu
self="$0"; while [ -L "$self" ]; do l="$(readlink "$self")"; case "$l" in /*) self="$l";; *) self="$(dirname "$self")/$l";; esac; done
SELF_DIR="$(cd "$(dirname "$self")" && pwd)"
HOOKS_DIR="$(cd "$SELF_DIR/hooks" && pwd)"

input="$(cat 2>/dev/null || true)"
cwd="$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null || true)"
[ -n "$cwd" ] && cd "$cwd" 2>/dev/null || true

git rev-parse --git-dir >/dev/null 2>&1 || exit 0                                  # not a repo
[ "$(git config --get commit-gate.disabled 2>/dev/null || echo false)" = true ] && exit 0   # opted out
hp="$(git config --get core.hooksPath 2>/dev/null || true)"
[ -n "$hp" ] && [ "$(cd "$hp" 2>/dev/null && pwd)" = "$HOOKS_DIR" ] && exit 0       # enabled

top="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
ctx="commit-gate is not configured in this repository ($top). Offer the user a choice: run \`gate-enable\` to gate commits/pushes here, or \`gate-disable\` to opt out permanently. Do NOT enable without the user's explicit yes."
jq -cn --arg c "$ctx" '{hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:$c}}'
exit 0
