# sourced by scripts AFTER they set SELF_DIR via the self-location snippet.
HOOKS_DIR="$(cd "$SELF_DIR/../hooks" && pwd)"
CANONICAL="$SELF_DIR/../lib/canonical"
die() { printf 'commit-gate: %s\n' "$*" >&2; exit 1; }
_common_dir() { local c; c="$(git rev-parse --git-common-dir 2>/dev/null)" || return 1; cd "$c" 2>/dev/null && pwd; }
gate_dir() { local c; c="$(_common_dir)" || return 1; printf '%s/commit-gate' "$c"; }
local_hooks_dir() { local c; c="$(_common_dir)" || return 1; printf '%s/hooks' "$c"; }
is_disabled() { [ "$(git config --get commit-gate.disabled 2>/dev/null || echo false)" = true ]; }
is_enabled() {
  local hp; hp="$(git config --get core.hooksPath 2>/dev/null || true)"
  [ -n "$hp" ] && [ "$(cd "$hp" 2>/dev/null && pwd)" = "$HOOKS_DIR" ]
}
require_enabled() {
  gate_dir >/dev/null 2>&1 || die "not inside a git repository"
  is_disabled && die "repo is opted out (commit-gate.disabled); run: gate-enable"
  is_enabled || die "repo not enabled — run: gate-enable"
}
# Run repo-local hook NAME (if executable) with args + inherited stdin; abort on its failure.
chain_local() {
  local name="$1"; shift
  local lh; lh="$(local_hooks_dir)" || return 0
  if [ -x "$lh/$name" ]; then "$lh/$name" "$@" || exit $?; fi
}
# Explicit human confirmation (callers gate it behind their own --yes for tests):
# macOS osascript dialog (works over the tty-less `!` shell) -> /dev/tty prompt -> abort.
confirm() {  # $1 = prompt text; returns 0 if confirmed, dies otherwise
  if [ "$(uname)" = Darwin ] && command -v osascript >/dev/null 2>&1; then
    osascript - "$1" >/dev/null 2>&1 <<'OSA' || die "aborted; not confirmed"
on run argv
  display dialog (item 1 of argv) buttons {"Cancel", "Confirm"} default button "Cancel" with title "commit-gate"
end run
OSA
    return 0
  fi
  if [ -e /dev/tty ] && { printf '%s [y/N] ' "$1" >/dev/tty; } 2>/dev/null; then
    local reply=''; read -r reply </dev/tty 2>/dev/null || reply=''
    case "$reply" in y|Y|yes|YES) return 0 ;; *) die "aborted; not confirmed" ;; esac
  fi
  die "no confirmation channel (no GUI, no tty) — run from a terminal"
}
