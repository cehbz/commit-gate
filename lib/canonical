#!/bin/bash
# Reads a commit message on stdin; writes its canonical sha256 (64 hex). Canonical form:
# CRLF->LF; strip trailing whitespace per line; drop trailing blank lines. The
# Co-Authored-By trailer, if present, is part of the message and IS hashed.
set -eu
msg="$(cat)"
printf '%s\n' "$msg" \
  | tr -d '\r' \
  | sed 's/[[:space:]]*$//' \
  | awk '{ lines[NR]=$0 } END { last=NR; while (last>0 && lines[last]=="") last--; for (i=1;i<=last;i++) print lines[i] }' \
  | shasum -a 256 | awk '{print $1}'
