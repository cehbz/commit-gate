#!/bin/bash
set -eu
self="$0"; while [ -L "$self" ]; do l="$(readlink "$self")"; case "$l" in /*) self="$l";; *) self="$(dirname "$self")/$l";; esac; done
SELF_DIR="$(cd "$(dirname "$self")" && pwd)"; . "$SELF_DIR/../lib/common"
gate_dir >/dev/null 2>&1 || die "not inside a git repository"
[ "${1:-}" = "--yes" ] || confirm "commit-gate — opt this repo OUT (disable the gate)?"
git config commit-gate.disabled true
echo "commit-gate: disabled (opted out) for $(git rev-parse --show-toplevel)"
