#!/bin/bash
set -eu
self="$0"; while [ -L "$self" ]; do l="$(readlink "$self")"; case "$l" in /*) self="$l";; *) self="$(dirname "$self")/$l";; esac; done
SELF_DIR="$(cd "$(dirname "$self")" && pwd)"; . "$SELF_DIR/../lib/common"
g="$(gate_dir)" || die "not inside a git repository"
if is_disabled; then echo "commit-gate: opted-out"; exit 0; fi
if is_enabled; then
  echo "commit-gate: enabled"
  if [ -s "$g/approved" ]; then echo "approved (pending):"; sed 's/^[0-9a-f]*  /  /' "$g/approved"; else echo "approved (pending): none"; fi
  [ -e "$g/push-token" ] && echo "push token: present" || echo "push token: none"
else
  echo "commit-gate: undecided (run enable to gate this repo, or disable to opt out)"
fi
